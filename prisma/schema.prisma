// ProjectHive database schema (MongoDB via Prisma).
// MongoDB has no SQL migrations: apply changes with `npm run db:push`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum DeveloperStatus {
  ACTIVE
  INACTIVE
}

enum ProjectType {
  ASSIGNMENT
  RESEARCH
  FINAL_YEAR_PROJECT
  SOFTWARE_PROJECT
  WEB_DEVELOPMENT
  MOBILE_APPLICATION
  MACHINE_LEARNING
  DATA_SCIENCE
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  REVIEW
  CLIENT_REVIEW
  REVISION
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  FULLY_PAID
  REFUNDED
}

enum ActivityAction {
  PROJECT_CREATED
  PROJECT_UPDATED
  DEVELOPER_ASSIGNED
  STATUS_CHANGED
  PAYMENT_UPDATED
  PROJECT_COMPLETED
}

model Admin {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  email          String   @unique
  passwordHash   String
  // Bumped on password change so older sessions stop working.
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("admins")
}

model Developer {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  phone     String          @default("")
  email     String          @default("")
  skills    String[]
  notes     String          @default("")
  status    DeveloperStatus @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  projects Project[]

  @@index([status])
  @@index([name])
  @@map("developers")
}

model Project {
  id                 String        @id @default(auto()) @map("_id") @db.ObjectId
  projectCode        String        @unique
  projectName        String
  projectType        ProjectType
  clientName         String
  clientPhone        String        @default("")
  clientEmail        String        @default("")
  description        String        @default("")
  subject            String        @default("")
  requirements       String        @default("")
  technologies       String        @default("")
  referenceMaterials String        @default("")
  developerId        String?       @db.ObjectId
  startDate          DateTime?
  deadline           DateTime
  priority           Priority      @default(MEDIUM)
  status             ProjectStatus @default(NEW)
  // Amounts are stored in LKR, rounded to 2 decimal places.
  developerCost      Float         @default(0)
  clientPrice        Float         @default(0)
  advancePaid        Float         @default(0)
  paymentStatus      PaymentStatus @default(PENDING)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  developer  Developer?        @relation(fields: [developerId], references: [id], onDelete: SetNull)
  activities ProjectActivity[]

  @@index([status])
  @@index([deadline])
  @@index([developerId])
  @@index([paymentStatus])
  @@index([projectType])
  @@index([createdAt])
  @@map("projects")
}

model ProjectActivity {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  projectId   String         @db.ObjectId
  action      ActivityAction
  description String
  createdAt   DateTime       @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("project_activities")
}

// Per-year sequence used to generate project codes (PH-2026-0001).
model Counter {
  id    String @id @map("_id")
  value Int    @default(0)

  @@map("counters")
}
